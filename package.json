{
  "name": "@leadtributor/n8n-nodes-leadtributor",
  "version": "0.5.0",
  "description": "n8n community node for leadtributor.cloud integration",
  "keywords": [
    "n8n-community-node-package",
    "leadtributor",
    "leadmanagement",
    "partnermanagement",
    "prm",
    "sales"
  ],
  "license": "MIT",
  "homepage": "https://github.com/leadtributor/n8n-nodes-leadtributor",
  "author": {
    "name": "leadtributor GmbH"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leadtributor/n8n-nodes-leadtributor.git"
  },
  "bugs": {
    "url": "https://github.com/leadtributor/n8n-nodes-leadtributor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:icons",
    "copy:icons": "node scripts/copy-icons.js",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts",
    "lintfix": "eslint nodes credentials package.json --ext .ts --fix"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LeadtributorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Leadtributor/Leadtributor.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "n8n-workflow": "*",
    "prettier": "^3.0.3",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
